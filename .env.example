# Copy this file to .env and fill in the values for YOUR Supabase project.
# .env is gitignored — it must exist when building debug AND release APKs.
# Never commit real keys.

# Supabase Configuration
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Maps & Geolocation
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Default Region: Makilala, North Cotabato, Philippines
DEFAULT_LATITUDE=6.9604
DEFAULT_LONGITUDE=125.0886

# EmailJS Configuration (for Registration Email OTP)
EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
EMAILJS_PRIVATE_KEY=YOUR_EMAILJS_PRIVATE_KEY_OPTIONAL
